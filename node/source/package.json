{
  "name": "factorinode-reconstruction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && vite build --base=/node/",
    "test": "vitest run",
    "progression": "node scripts/run-progression.mjs",
    "balance:audit": "node scripts/balance-audit.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:milestones": "node scripts/build-milestone-preview.mjs",
    "preview:status": "node scripts/build-status-preview.mjs",
    "preview:sounds": "npm run preview:music:ambient && node scripts/build-action-sounds.mjs",
    "preview:sound-game": "npm run preview:sounds && node scripts/build-sound-playground.mjs",
    "preview:music": "node scripts/build-bass-melody.mjs",
    "preview:music:cello": "node scripts/build-bass-melody.mjs --cello",
    "preview:music:cello:lighter": "node scripts/build-bass-melody.mjs --lighter",
    "preview:music:soft-cello": "node scripts/build-bass-melody.mjs --soft",
    "preview:music:soft-bass": "node scripts/build-bass-melody.mjs --soft --bass",
    "preview:music:ambient": "node scripts/build-ambient-music.mjs",
    "audio:sync": "node scripts/sync-game-audio.mjs",
    "preview:item-art": "node scripts/build-item-art.mjs",
    "preview:border-art": "node scripts/build-border-art.mjs",
    "preview:terrain": "node scripts/build-terrain-preview.mjs",
    "docs:systems": "node scripts/system-docs.mjs",
    "docs:systems:check": "node scripts/system-docs.mjs --check",
    "changelog": "node scripts/changelog.mjs",
    "changelog:check": "node scripts/changelog.mjs --check && node --test scripts/check-changelog.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "pixi.js": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
