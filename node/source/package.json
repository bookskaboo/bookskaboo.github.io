{
  "name": "factorinode-reconstruction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && vite build --base=/node/",
    "test": "vitest run",
    "stress": "node scripts/run-stress.mjs",
    "progression": "node scripts/run-progression.mjs",
    "balance:audit": "node scripts/balance-audit.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "changelog": "node scripts/changelog.mjs",
    "changelog:check": "node scripts/changelog.mjs --check && node --test scripts/check-changelog.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "pixi.js": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
